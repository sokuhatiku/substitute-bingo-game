{
	"width": 1280,
	"height": 720,
	"fps": 30,
	"main": "./script/_bootstrap.js",
	"assets": {
		"assetLoader": {
			"type": "script",
			"path": "script/assetLoader.js",
			"global": true
		},
		"bingoCell": {
			"type": "script",
			"path": "script/game/bingoCell.js",
			"global": true
		},
		"main": {
			"type": "script",
			"path": "script/main.js",
			"global": true
		},
		"niconamaGameBridge": {
			"type": "script",
			"path": "script/niconamaGameBridge.js",
			"global": true
		},
		"parameterObject": {
			"type": "script",
			"path": "script/parameterObject.js",
			"global": true
		},
		"_bootstrap": {
			"type": "script",
			"path": "script/_bootstrap.js",
			"global": true
		},
		"progressBar": {
			"type": "script",
			"path": "script/progressBar.js",
			"global": true
		},
		"lotteryMachine": {
			"type": "script",
			"path": "script/game/lotteryMachine.js",
			"global": true
		},
		"roulette": {
			"type": "audio",
			"path": "audio/roulette",
			"systemId": "sound",
			"duration": 2668,
			"hint": {
				"extensions": [
					".m4a",
					".ogg"
				]
			}
		},
		"check": {
			"type": "audio",
			"path": "audio/check",
			"systemId": "sound",
			"duration": 1143,
			"hint": {
				"extensions": [
					".m4a",
					".ogg"
				]
			}
		},
		"bingo": {
			"type": "audio",
			"path": "audio/bingo",
			"systemId": "sound",
			"duration": 4500,
			"hint": {
				"extensions": [
					".m4a",
					".ogg"
				]
			}
		},
		"bingoAnnounce": {
			"type": "script",
			"path": "script/game/bingoAnnounce.js",
			"global": true
		},
		"reach": {
			"type": "audio",
			"path": "audio/reach",
			"systemId": "sound",
			"duration": 1698,
			"hint": {
				"extensions": [
					".m4a",
					".ogg"
				]
			}
		},
		"joinButton": {
			"type": "script",
			"path": "script/game/joinButton.js",
			"global": true
		}
	},
	"environment": {
		"sandbox-runtime": "3",
		"nicolive": {
			"supportedModes": [
				"ranking"
			],
			"preferredSessionParameters": {
				"totalTimeLimit": 90
			}
		}
	},
	"globalScripts": [
		"node_modules/@akashic-extension/akashic-label/lib/DefaultRubyParser.js",
		"node_modules/@akashic-extension/akashic-label/lib/FragmentDrawInfo.js",
		"node_modules/@akashic-extension/akashic-label/lib/Label.js",
		"node_modules/@akashic-extension/akashic-label/lib/RubyParser.js",
		"node_modules/@akashic-extension/akashic-label/lib/index.js",
		"node_modules/@akashic-extension/akashic-timeline/lib/ActionType.js",
		"node_modules/@akashic-extension/akashic-timeline/lib/Easing.js",
		"node_modules/@akashic-extension/akashic-timeline/lib/Timeline.js",
		"node_modules/@akashic-extension/akashic-timeline/lib/Tween.js",
		"node_modules/@akashic-extension/akashic-timeline/lib/index.js"
	],
	"moduleMainScripts": {
		"@akashic-extension/akashic-timeline": "node_modules/@akashic-extension/akashic-timeline/lib/index.js",
		"@akashic-extension/akashic-label": "node_modules/@akashic-extension/akashic-label/lib/index.js"
	}
}